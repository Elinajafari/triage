# studionet (default, gasless) | testnet-asimov
GENLAYER_NETWORK=studionet

# On studionet, empty keys mean a fresh wallet per role for every run.
# On a funded network all of them are required. Never commit real keys.
DEPLOYER_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
RESIDENT_PRIVATE_KEY=
REPAIRS_PRIVATE_KEY=
NEIGHBOURS_PRIVATE_KEY=
BILLING_PRIVATE_KEY=
STRANGER_PRIVATE_KEY=
